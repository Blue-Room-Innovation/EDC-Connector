# Ajustes personalizables para el Embedded Persistent Connector
CONNECTOR_CONTAINER_NAME=connector
CONNECTOR_DB_CONTAINER_NAME=connector-db
CONNECTOR_IMAGE=minimal-connector:latest

# Valores por defecto orientados al escenario i2cat. Un DID ficticio de ejemplo está en resources/identity/did.json
CONNECTOR_HOSTNAME=connector
CONNECTOR_PARTICIPANT_ID=did:web:connector%3A8282
CONNECTOR_ISSUER_ID=did:web:connector%3A8282
CONNECTOR_DID_WEB_USE_HTTPS=false
CONNECTOR_DSP_CALLBACK_ADDRESS=http://connector:8282/api/dsp
CONNECTOR_DSP_SCOPE=org.eclipse.edc.vc.type:MembershipCredential:read

CONNECTOR_DB_HOST=connector-db
CONNECTOR_DB_NAME=minimal_connector
CONNECTOR_DB_USER=connector
CONNECTOR_DB_PASSWORD=connector
CONNECTOR_DB_PORT=5532
CONNECTOR_SQL_AUTOCREATE=true

CONNECTOR_VAULT_URL=http://provider-vault:8200
CONNECTOR_VAULT_TOKEN=root
CONNECTOR_STS_TOKEN_URL=http://host.docker.internal:8582/api/sts/token
CONNECTOR_STS_CLIENT_ID=did:web:connector%3A8282
CONNECTOR_STS_CLIENT_SECRET_ALIAS=did:web:connector%3A8282-sts-client-secret
CONNECTOR_STS_PRIVATE_KEY_ALIAS=did:web:connector%3A8282#key-1
CONNECTOR_STS_PUBLIC_KEY_ID=did:web:connector%3A8282#key-1

CONNECTOR_API_AUTH_KEY=edc-dev
CONNECTOR_MANAGEMENT_AUTH_KEY=edc-dev
CONNECTOR_CATALOG_AUTH_KEY=edc-dev

CONNECTOR_CONFIGURATION_FILE=./configuration.properties
CONNECTOR_LOGGING_FILE=./logging.properties
CONNECTOR_LOGS_DIR=./logs

CONNECTOR_HTTP_PORT=8181
CONNECTOR_MANAGEMENT_PORT=9081
CONNECTOR_PROTOCOL_PORT=9082
CONNECTOR_CONTROL_PORT=9083
CONNECTOR_CATALOG_PORT=9084

CONNECTOR_EXTERNAL_NETWORK=edc-scenario-main_default
PROVIDER_CONTROLPLANE_HOST=provider-controlplane
PROVIDER_CONTROLPLANE_GATEWAY=host-gateway

CONNECTOR_DID_DOCUMENT_PATH=/app/resources/identity/did.json
