# --- HTTP ports & paths ---
web.http.port=8280
web.http.path=/api
web.http.credentials.port=8281
web.http.credentials.path=/api/credentials
web.http.identity.port=8282
web.http.identity.path=/api/identity
web.http.did.port=8283
web.http.did.path=/
web.http.version.port=8285
web.http.version.path=/api/version
web.http.sts.port=8286
web.http.sts.path=/api/sts

# --- Identity ---
edc.iam.did.web.use.https=false
edc.iam.sts.privatekey.alias=my-connector-key
edc.iam.sts.publickey.id=did:web:localhost%3A8281#key-1
edc.ih.iam.publickey.path=./deployment/assets/public.pem
edc.ih.iam.privatekey.path=./deployment/assets/private.pem
edc.ih.iam.id=did:web:localhost%3A8281
edc.ih.api.superuser.key=c3VwZXItdXNlcg==.c3VwZXItc2VjcmV0LWtleQo=

# --- Credentials ---
edc.mvd.credentials.path=deployment/assets/credentials/
