# --- Control Plane Configuration ---
edc.iam.issuer.id=did:web:localhost%3A8281

# HTTP endpoints
web.http.port=8280
web.http.path=/api
web.http.management.port=8281
web.http.management.path=/api/management/
web.http.management.auth.type=tokenbased
web.http.management.auth.key=password

web.http.protocol.port=8282
web.http.protocol.path=/api/dsp

web.http.control.port=8283
web.http.control.path=/api/control

web.http.catalog.port=8284
web.http.catalog.path=/api/catalog
web.http.catalog_auth.type=tokenbased
web.http.catalog_auth.key=password

web.http.version.port=8285
web.http.version.path=/api/version

# Identity and Security
edc.iam.did.web.use.https=false
edc.iam.sts.privatekey.alias=did:web:localhost%3A8281-alias
edc.iam.sts.publickey.id=did:web:localhost%3A8281#key-1

# DSP Callback (for incoming negotiation requests)
edc.dsp.callback.address=http://localhost:8282/api/dsp

# Participant identity
edc.participant.id=did:web:localhost%3A8281

# Catalog polling (optional)
edc.catalog.cache.execution.delay.seconds=5
edc.catalog.cache.execution.period.seconds=10

# Reference to participants list (MVD-aware)
edc.mvd.participants.list.file=deployment/assets/participants/participants.local.json

# Enable management context
edc.management.context.enabled=true

# STS OAuth Config
edc.iam.sts.oauth.client.secret.alias=did:web:localhost%3A8281-sts-client-secret
edc.iam.sts.oauth.client.id=did:web:localhost%3A8281
edc.iam.sts.oauth.token.url=http://localhost:8286/api/sts/token

# --- Dataplane Configuration ---
edc.runtime.id=my-connector-runtime
edc.transfer.proxy.token.verifier.publickey.alias=did:web:localhost%3A8281#key-1
edc.transfer.proxy.token.signer.privatekey.alias=did:web:localhost%3A8281-alias
edc.dpf.selector.url=http://localhost:8283/api/control/v1/dataplanes

# Public dataplane API
web.http.public.port=8290
web.http.public.path=/api/public
